[Unit]
Description=Romifleur VM103
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-romifleur/cluster-listener-firewall.py --port 18086
ExecStart=/usr/bin/docker compose -p homelab-romifleur -f /etc/homelab-romifleur/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-romifleur -f /etc/homelab-romifleur/compose.json down
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
