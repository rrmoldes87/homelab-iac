[Unit]
Description=Homebox VM103 original binary
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-homebox/cluster-listener-firewall.py --port 18088
ExecStart=/usr/bin/docker compose -p homelab-homebox -f /etc/homelab-homebox/compose.json -f /etc/homelab-homebox/env.private.json up -d
ExecStop=/usr/bin/docker compose -p homelab-homebox -f /etc/homelab-homebox/compose.json -f /etc/homelab-homebox/env.private.json down
TimeoutStartSec=240
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
