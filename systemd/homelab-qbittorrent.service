[Unit]
Description=qbittorrent VM103 original image and media paths
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-qbittorrent/cluster-listener-firewall.py --port 18098
ExecStartPre=/usr/bin/python3 /etc/homelab-qbittorrent/cluster-listener-firewall.py --port 6881
ExecStartPre=/usr/bin/python3 /etc/homelab-qbittorrent/cluster-listener-firewall.py --port 6881 --protocol udp
ExecStart=/usr/bin/docker compose -p homelab-qbittorrent -f /etc/homelab-qbittorrent/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-qbittorrent -f /etc/homelab-qbittorrent/compose.json down
TimeoutStartSec=240
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
