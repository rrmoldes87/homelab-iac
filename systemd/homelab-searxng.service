[Unit]
Description=Dedicated SearXNG VM103 production backend
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-searxng/cluster-listener-firewall.py --port 18083
ExecStart=/usr/bin/docker compose -p homelab-searxng -f /etc/homelab-searxng/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-searxng -f /etc/homelab-searxng/compose.json down
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
