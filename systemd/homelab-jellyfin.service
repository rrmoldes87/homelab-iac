[Unit]
Description=Jellyfin VM103 exact image and original media scope
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-jellyfin/listener-firewall.py --port 18114
ExecStart=/usr/bin/docker compose -p homelab-jellyfin -f /etc/homelab-jellyfin/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-jellyfin -f /etc/homelab-jellyfin/compose.json down
TimeoutStartSec=240
TimeoutStopSec=120
[Install]
WantedBy=multi-user.target
