[Unit]
Description=Dedicated Dependency-Track frontend VM103
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-dtrack-frontend/cluster-listener-firewall.py --port 18084
ExecStart=/usr/bin/docker compose -p homelab-dtrack-frontend -f /etc/homelab-dtrack-frontend/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-dtrack-frontend -f /etc/homelab-dtrack-frontend/compose.json down
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
