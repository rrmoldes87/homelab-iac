[Unit]
Description=Forgejo exact-image VM103 single writer
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-forgejo/runner-fence.py
ExecStartPre=/usr/bin/python3 /etc/homelab-forgejo/listener-firewall.py --port 18116
ExecStartPre=/usr/bin/python3 /etc/homelab-forgejo/listener-firewall.py --port 18117
ExecStart=/usr/bin/docker compose -p homelab-forgejo -f /etc/homelab-forgejo/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-forgejo -f /etc/homelab-forgejo/compose.json down
TimeoutStartSec=240
TimeoutStopSec=120
[Install]
WantedBy=multi-user.target
