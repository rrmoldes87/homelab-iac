[Unit]
Description=audiobookshelf VM103 original image and media paths
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-audiobookshelf/cluster-listener-firewall.py --port 18093
ExecStart=/usr/bin/docker compose -p homelab-audiobookshelf -f /etc/homelab-audiobookshelf/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-audiobookshelf -f /etc/homelab-audiobookshelf/compose.json down
TimeoutStartSec=240
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
