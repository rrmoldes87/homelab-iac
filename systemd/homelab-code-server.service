[Unit]
Description=Code-server VM103 original binary and workspace
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-code-server/cluster-listener-firewall.py --port 18090
ExecStart=/usr/bin/docker compose -p homelab-code-server -f /etc/homelab-code-server/compose.json -f /etc/homelab-code-server/env.private.json up -d
ExecStop=/usr/bin/docker compose -p homelab-code-server -f /etc/homelab-code-server/compose.json -f /etc/homelab-code-server/env.private.json down
TimeoutStartSec=240
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
