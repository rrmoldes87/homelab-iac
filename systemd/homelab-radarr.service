[Unit]
Description=radarr VM103 original image and media paths
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-radarr/cluster-listener-firewall.py --port 18095
ExecStart=/usr/bin/docker compose -p homelab-radarr -f /etc/homelab-radarr/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-radarr -f /etc/homelab-radarr/compose.json down
TimeoutStartSec=240
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
