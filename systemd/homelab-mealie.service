[Unit]
Description=Mealie VM103
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-mealie/cluster-listener-firewall.py --port 18087
ExecStart=/usr/bin/docker compose -p homelab-mealie -f /etc/homelab-mealie/compose.json -f /etc/homelab-mealie/env.private.json up -d
ExecStop=/usr/bin/docker compose -p homelab-mealie -f /etc/homelab-mealie/compose.json -f /etc/homelab-mealie/env.private.json down
TimeoutStartSec=240
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
