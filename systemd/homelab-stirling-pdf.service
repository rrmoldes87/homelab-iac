[Unit]
Description=StirlingPDF VM103
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-stirling-pdf/cluster-listener-firewall.py --port 18085
ExecStart=/usr/bin/docker compose -p homelab-stirling-pdf -f /etc/homelab-stirling-pdf/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-stirling-pdf -f /etc/homelab-stirling-pdf/compose.json down
TimeoutStartSec=240
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
