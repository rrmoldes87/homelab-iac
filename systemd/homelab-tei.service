[Unit]
Description=TEI exact-image offline model inference
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-tei/listener-firewall.py --port 18115
ExecStart=/usr/bin/docker compose -p homelab-tei -f /etc/homelab-tei/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-tei -f /etc/homelab-tei/compose.json down
TimeoutStartSec=180
[Install]
WantedBy=multi-user.target
