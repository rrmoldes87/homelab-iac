[Unit]
Description=Actual Budget VM103 exact source binary and cold state
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-actual-budget/cluster-listener-firewall.py --port 18107
ExecStart=/usr/bin/docker compose -p homelab-actual-budget -f /etc/homelab-actual-budget/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-actual-budget -f /etc/homelab-actual-budget/compose.json down
TimeoutStartSec=240
TimeoutStopSec=150
[Install]
WantedBy=multi-user.target
