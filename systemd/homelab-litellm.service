[Unit]
Description=Prowlarr VM103 original binary and preserved indexer configuration
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-litellm/cluster-listener-firewall.py --port 18102
ExecStart=/usr/bin/docker compose -p homelab-litellm -f /etc/homelab-litellm/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-litellm -f /etc/homelab-litellm/compose.json down
TimeoutStartSec=240
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
