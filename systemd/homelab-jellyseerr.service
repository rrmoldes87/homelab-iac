[Unit]
Description=Jellyseerr VM103 original binary and current configuration
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 /etc/homelab-jellyseerr/cluster-listener-firewall.py --port 18091
ExecStart=/usr/bin/docker compose -p homelab-jellyseerr -f /etc/homelab-jellyseerr/compose.json up -d
ExecStop=/usr/bin/docker compose -p homelab-jellyseerr -f /etc/homelab-jellyseerr/compose.json down
TimeoutStartSec=240
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
