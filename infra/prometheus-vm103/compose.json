{
  "name": "homelab-monitoring",
  "services": {
    "prometheus": {
      "image": "prom/prometheus:v3.5.0",
      "restart": "unless-stopped",
      "mem_limit": "640m",
      "cpus": 1.0,
      "command": [
        "--config.file=/etc/prometheus/prometheus.json",
        "--storage.tsdb.path=/prometheus",
        "--storage.tsdb.retention.time=15d",
        "--storage.tsdb.retention.size=1GB",
        "--web.enable-lifecycle"
      ],
      "ports": [
        "127.0.0.1:19090:9090"
      ],
      "volumes": [
        "./prometheus.json:/etc/prometheus/prometheus.json:ro",
        "./rules.json:/etc/prometheus/rules.json:ro",
        "prometheus:/prometheus"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      }
    },
    "grafana": {
      "image": "grafana/grafana:12.1.1",
      "restart": "unless-stopped",
      "mem_limit": "512m",
      "cpus": 1.0,
      "ports": [
        "192.168.1.92:18300:3000"
      ],
      "environment": {
        "GF_SERVER_ROOT_URL": "https://grafana.<TU_DOMINIO>",
        "GF_SECURITY_ADMIN_USER": "<TU_USUARIO>",
        "GF_SECURITY_ADMIN_PASSWORD__FILE": "/run/secrets/grafana-password",
        "GF_USERS_ALLOW_SIGN_UP": "false",
        "GF_AUTH_ANONYMOUS_ENABLED": "false",
        "GF_ANALYTICS_REPORTING_ENABLED": "false",
        "GF_ANALYTICS_CHECK_FOR_UPDATES": "false",
        "GF_SECURITY_COOKIE_SECURE": "true",
        "GF_SECURITY_COOKIE_SAMESITE": "lax",
        "GF_INSTALL_PLUGINS": "victoriametrics-logs-datasource"
      },
      "volumes": [
        "grafana:/var/lib/grafana",
        "./provisioning:/etc/grafana/provisioning:ro",
        "./dashboards:/var/lib/grafana/dashboards:ro",
        "/etc/homelab-monitoring/grafana-password:/run/secrets/grafana-password:ro"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "env_file": [
        "/etc/homelab-monitoring/grafana-oidc.env"
      ]
    },
    "alertmanager": {
      "image": "prom/alertmanager:v0.28.1",
      "restart": "unless-stopped",
      "mem_limit": "128m",
      "cpus": 0.25,
      "command": [
        "--config.file=/etc/alertmanager/alertmanager.json",
        "--storage.path=/alertmanager",
        "--data.retention=120h",
        "--cluster.listen-address="
      ],
      "ports": [
        "127.0.0.1:19093:9093"
      ],
      "volumes": [
        "./alertmanager.json:/etc/alertmanager/alertmanager.json:ro",
        "alertmanager:/alertmanager"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      }
    },
    "node-vm103": {
      "image": "prom/node-exporter:v1.9.1",
      "restart": "unless-stopped",
      "mem_limit": "96m",
      "cpus": 0.25,
      "pid": "host",
      "command": [
        "--path.rootfs=/host",
        "--collector.filesystem.mount-points-exclude=^/(dev|proc|sys|var/lib/docker/.+|var/lib/containerd/.+)($|/)",
        "--no-collector.arp",
        "--no-collector.wifi"
      ],
      "volumes": [
        "/:/host:ro,rslave"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      }
    }
  },
  "networks": {
    "default": {
      "ipam": {
        "config": [
          {
            "subnet": "10.253.103.0/24"
          }
        ]
      }
    }
  },
  "volumes": {
    "prometheus": {},
    "grafana": {},
    "alertmanager": {}
  }
}