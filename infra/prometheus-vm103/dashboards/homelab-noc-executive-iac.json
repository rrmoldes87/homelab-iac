{
  "uid": "homelab-noc-executive-iac",
  "title": "Homelab NOC (Vista Global)",
  "tags": [
    "homelab",
    "noc",
    "iac"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets Prometheus UP",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodos Proxmox UP",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pve_up{id=~\"node/.*\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DNS VIP .53 OK",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox-dns\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Traefik HA Nodos UP",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"traefik-ct148\"} + up{job=\"traefik-ct152\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sondas HTTPS CrÃ­ticas OK",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(probe_success{job=\"blackbox-http\"})"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "MÃ­n. DÃ­as TLS Wildcard",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min((probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latencia HTTPS Servicios CrÃ­ticos (s)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"blackbox-http\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "TrÃ¡fico Traefik HA (req/s)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, code) (rate(traefik_entrypoint_requests_total{job=~\"traefik-.*\"}[5m]))",
          "legendFormat": "{{job}} {{code}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RAM Usada por Nodo PVE (%)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(pve_memory_usage_bytes{id=~\"node/.*\"} / pve_memory_size_bytes{id=~\"node/.*\"}) * 100",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Uso de Almacenamiento PVE (%)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(pve_disk_usage_bytes{id=~\"storage/.*\"} / pve_disk_size_bytes{id=~\"storage/.*\"}) * 100",
          "legendFormat": "{{node}} {{id}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ingesta VictoriaLogs (eventos/s)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vl_rows_ingested_total{job=\"victorialogs\"}[5m]))",
          "legendFormat": "ingesta/s"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Top 8 Contenedores VM103 por RAM",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, container_memory_working_set_bytes{job=\"cadvisor-vm103\",name!=\"\"})",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}