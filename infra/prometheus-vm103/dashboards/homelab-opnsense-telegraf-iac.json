{
  "uid": "homelab-opnsense-telegraf-iac",
  "title": "OPNsense Firewall & Gateway (Telegraf)",
  "tags": [
    "homelab",
    "iac"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "OPNsense Target UP",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"opnsense-telegraf\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU Activa (%)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - avg(cpu_usage_idle{job=\"opnsense-telegraf\",cpu=\"cpu-total\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "RAM Usada (%)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mem_used_percent{job=\"opnsense-telegraf\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Disco RaÃ­z Usado (%)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(disk_used_percent{job=\"opnsense-telegraf\",path=\"/\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU OPNsense (User/System/IRQ)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cpu_usage_user{job=\"opnsense-telegraf\",cpu=\"cpu-total\"} or cpu_usage_system{job=\"opnsense-telegraf\",cpu=\"cpu-total\"}",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "TrÃ¡fico RX/TX por Interfaz (bytes/s)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(net_bytes_recv{job=\"opnsense-telegraf\",interface=~\"igc.*|pppoe.*|wg.*\"}[5m]) or rate(net_bytes_sent{job=\"opnsense-telegraf\",interface=~\"igc.*|pppoe.*|wg.*\"}[5m])",
          "legendFormat": "{{__name__}} {{interface}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Load Average OPNsense",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system_load1{job=\"opnsense-telegraf\"} or system_load5{job=\"opnsense-telegraf\"}",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errores/Drops Red OPNsense",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(net_drop_in{job=\"opnsense-telegraf\"}[5m]) + rate(net_drop_out{job=\"opnsense-telegraf\"}[5m])",
          "legendFormat": "{{interface}}"
        }
      ]
    }
  ]
}