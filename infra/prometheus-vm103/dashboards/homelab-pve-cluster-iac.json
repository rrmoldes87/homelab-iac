{
  "uid": "homelab-pve-cluster-iac",
  "title": "Proxmox VE Cluster (pve-exporter)",
  "tags": [
    "homelab",
    "iac"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodos PVE UP",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pve_up{id=~\"node/.*\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "VMs/CTs Running",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(pve_up{id=~\"(qemu|lxc)/.*\"} == 1)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU Media ClÃºster",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(pve_cpu_usage_ratio{id=~\"node/.*\"}) * 100"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "RAM Usada Total ClÃºster",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pve_memory_usage_bytes{id=~\"node/.*\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU por Nodo PVE (%)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pve_cpu_usage_ratio{id=~\"node/.*\"} * 100",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "RAM Usada por Nodo PVE (%)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(pve_memory_usage_bytes{id=~\"node/.*\"} / pve_memory_size_bytes{id=~\"node/.*\"}) * 100",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Top 10 Invitados por RAM",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, pve_memory_usage_bytes{id=~\"(qemu|lxc)/.*\"})",
          "legendFormat": "{{id}} ({{node}})"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Uso de Almacenamiento (%)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(pve_disk_usage_bytes{id=~\"storage/.*\"} / pve_disk_size_bytes{id=~\"storage/.*\"}) * 100",
          "legendFormat": "{{id}} ({{node}})"
        }
      ]
    }
  ]
}