{
  "uid": "homelab-vm103-containers-iac",
  "title": "VM103 Docker Containers (cAdvisor)",
  "tags": [
    "homelab",
    "docker",
    "iac"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Contenedores Activos VM103",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(container_last_seen{job=\"cadvisor-vm103\",name!=\"\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RAM Total Contenedores VM103",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{job=\"cadvisor-vm103\",name!=\"\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU Total Contenedores (cores)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"cadvisor-vm103\",name!=\"\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "cAdvisor Target UP",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"cadvisor-vm103\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Top 12 Contenedores por RAM (Working Set)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, container_memory_working_set_bytes{job=\"cadvisor-vm103\",name!=\"\"})",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Top 12 Contenedores por CPU (cores)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, rate(container_cpu_usage_seconds_total{job=\"cadvisor-vm103\",name!=\"\"}[5m]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "TrÃ¡fico Red RX por Contenedor (bytes/s)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name) (rate(container_network_receive_bytes_total{job=\"cadvisor-vm103\",name!=\"\"}[5m])))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "TrÃ¡fico Red TX por Contenedor (bytes/s)",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name) (rate(container_network_transmit_bytes_total{job=\"cadvisor-vm103\",name!=\"\"}[5m])))",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}