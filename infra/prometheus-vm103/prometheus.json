{
  "global": {
    "scrape_interval": "30s",
    "evaluation_interval": "30s",
    "external_labels": {
      "site": "homelab"
    }
  },
  "rule_files": [
    "/etc/prometheus/rules.json"
  ],
  "alerting": {
    "alertmanagers": [
      {
        "static_configs": [
          {
            "targets": [
              "alertmanager:9093"
            ]
          }
        ]
      }
    ]
  },
  "scrape_configs": [
    {
      "job_name": "prometheus",
      "static_configs": [
        {
          "targets": [
            "localhost:9090"
          ]
        }
      ]
    },
    {
      "job_name": "alertmanager",
      "static_configs": [
        {
          "targets": [
            "alertmanager:9093"
          ]
        }
      ]
    },
    {
      "job_name": "node",
      "static_configs": [
        {
          "targets": [
            "192.168.1.200:9100"
          ],
          "labels": {
            "node": "jupiter"
          }
        },
        {
          "targets": [
            "192.168.1.210:9100"
          ],
          "labels": {
            "node": "saturno"
          }
        },
        {
          "targets": [
            "192.168.1.221:9100"
          ],
          "labels": {
            "node": "urano"
          }
        },
        {
          "targets": [
            "node-vm103:9100"
          ],
          "labels": {
            "node": "compose-core"
          }
        }
      ]
    },
    {
      "job_name": "homelab",
      "scrape_timeout": "15s",
      "static_configs": [
        {
          "targets": [
            "192.168.1.155:9810"
          ]
        }
      ]
    },
    {
      "job_name": "opnsense-telegraf",
      "scrape_timeout": "10s",
      "static_configs": [
        {
          "targets": [
            "192.168.1.1:9273"
          ],
          "labels": {
            "node": "opnsense"
          }
        }
      ]
    },
    {
      "job_name": "pve-jupiter",
      "metrics_path": "/pve",
      "params": {
        "target": [
          "192.168.1.200"
        ]
      },
      "scrape_timeout": "15s",
      "static_configs": [
        {
          "targets": [
            "192.168.1.215:9221"
          ],
          "labels": {
            "node": "jupiter"
          }
        }
      ]
    },
    {
      "job_name": "pve-saturno",
      "metrics_path": "/pve",
      "params": {
        "target": [
          "192.168.1.210"
        ]
      },
      "scrape_timeout": "15s",
      "static_configs": [
        {
          "targets": [
            "192.168.1.216:9221"
          ],
          "labels": {
            "node": "saturno"
          }
        }
      ]
    },
    {
      "job_name": "pve-urano",
      "metrics_path": "/pve",
      "params": {
        "target": [
          "192.168.1.221"
        ]
      },
      "scrape_timeout": "15s",
      "static_configs": [
        {
          "targets": [
            "192.168.1.146:9221"
          ],
          "labels": {
            "node": "urano"
          }
        }
      ]
    },
    {
      "job_name": "traefik-ct148",
      "scrape_timeout": "10s",
      "static_configs": [
        {
          "targets": [
            "192.168.1.96:8082"
          ],
          "labels": {
            "node": "urano",
            "service": "traefik"
          }
        }
      ]
    },
    {
      "job_name": "cadvisor-vm103",
      "scrape_timeout": "15s",
      "static_configs": [
        {
          "targets": [
            "homelab-cadvisor:8080"
          ],
          "labels": {
            "node": "compose-core"
          }
        }
      ]
    },
    {
      "job_name": "traefik-ct152",
      "scrape_timeout": "10s",
      "static_configs": [
        {
          "targets": [
            "192.168.1.98:8082"
          ],
          "labels": {
            "node": "jupiter",
            "service": "traefik-backup"
          }
        }
      ]
    },
    {
      "job_name": "victorialogs",
      "scrape_timeout": "10s",
      "static_configs": [
        {
          "targets": [
            "192.168.1.97:9428"
          ],
          "labels": {
            "node": "saturno",
            "service": "victorialogs"
          }
        }
      ]
    },
    {
      "job_name": "blackbox-http",
      "metrics_path": "/probe",
      "params": {
        "module": [
          "http_homelab"
        ]
      },
      "scrape_timeout": "10s",
      "static_configs": [
        {
          "targets": [
            "https://auth.<TU_DOMINIO>/",
            "https://vaultwarden.<TU_DOMINIO>/",
            "https://jellyfin.<TU_DOMINIO>/health",
            "https://immich.<TU_DOMINIO>/",
            "https://haos.<TU_DOMINIO>/",
            "https://forgejo.<TU_DOMINIO>/",
            "https://nextcloud.<TU_DOMINIO>/status.php",
            "https://glance.<TU_DOMINIO>/"
          ]
        }
      ],
      "relabel_configs": [
        {
          "source_labels": [
            "__address__"
          ],
          "target_label": "__param_target"
        },
        {
          "source_labels": [
            "__param_target"
          ],
          "target_label": "instance"
        },
        {
          "target_label": "__address__",
          "replacement": "homelab-blackbox:9115"
        }
      ]
    },
    {
      "job_name": "blackbox-dns",
      "metrics_path": "/probe",
      "params": {
        "module": [
          "dns_vip53"
        ]
      },
      "scrape_timeout": "6s",
      "static_configs": [
        {
          "targets": [
            "192.168.1.53"
          ]
        }
      ],
      "relabel_configs": [
        {
          "source_labels": [
            "__address__"
          ],
          "target_label": "__param_target"
        },
        {
          "source_labels": [
            "__param_target"
          ],
          "target_label": "instance"
        },
        {
          "target_label": "__address__",
          "replacement": "homelab-blackbox:9115"
        }
      ]
    }
  ]
}