# Plantilla para /etc/homelab-monitoring/grafana-oidc.env (permisos 0600, fuera de Git)
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Authentik
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=<OIDC_CLIENT_ID_GRAFANA>
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=<OIDC_CLIENT_SECRET_GRAFANA>
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://authentik.<TU_DOMINIO>/application/o/authorize/
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://authentik.<TU_DOMINIO>/application/o/token/
GF_AUTH_GENERIC_OAUTH_API_URL=https://authentik.<TU_DOMINIO>/application/o/userinfo/
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'Authentik Admins') && 'Admin' || 'Viewer'
