VLOGS_URL = "http://192.168.1.97:9428/select/logsql/query"

def fetch_recent_vlogs(service_key, limit=4):
    """Fetch up to 4 recent error/warning log lines from VictoriaLogs to enrich alerts."""
    try:
        q = f"_time:15m ({service_key}) | sort by (_time) desc"
        data = urllib.parse.urlencode({"query": q, "limit": str(limit)}).encode()
        req = urllib.request.Request(VLOGS_URL, data=data, method="POST")
        with urllib.request.urlopen(req, timeout=4) as r:
            lines = []
            for ln in r.read().decode("utf-8", "ignore").splitlines()[:limit]:
                j = json.loads(ln)
                msg = str(j.get("_msg", "")).replace("`", "'")[:140]
                src = j.get("container_name") or j.get("host") or ""
                if msg:
                    lines.append(f"- [{src}] {msg}")
            return "\n".join(lines)
    except Exception:
        return ""


def send_telegram(text):
    if not BOT_TOKEN or not CHAT_ID:
        return False
    try:
        url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
        payload = urllib.parse.urlencode({"chat_id": CHAT_ID, "text": text, "parse_mode": "Markdown"}).encode()
        req = urllib.request.Request(url, data=payload, method="POST")
        with urllib.request.urlopen(req, timeout=5) as resp:
            return resp.status == 200
    except Exception as e:
        print(f"[ERROR] Failed to send Telegram alert: {e}")
        return False


def check_tcp_port(ip, port, timeout=2):
    s = socket.socket()
    s.settimeout(timeout)
    try:
        s.connect((ip, port))
        s.close()
        return True
    except Exception:
        return False


def check_http_url(url, timeout=4):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "HomelabRemediator/3.0"})
        with urllib.request.urlopen(req, context=ctx, timeout=timeout) as resp:
            return resp.status in [200, 301, 302, 401, 403]
    except urllib.error.HTTPError as e:
        return e.code in [200, 301, 302, 401, 403]
    except Exception:
        return False


def clean_key(name):
    return (name or "").lower().replace(" ", "").replace("-", "").replace("_", "")


def match_service(name_str):
    if not name_str:
        return None, None
    target = clean_key(name_str)
    for key, spec in SERVICE_CATALOG.items():
        if key in target or target in key:
            return key, spec
    return target, None


def ssh_cmd(node_ip, remote_cmd):
    return [
        "ssh", "-i", SSH_KEY, "-o", "IdentitiesOnly=yes",
        "-o", "StrictHostKeyChecking=no", "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=5", f"root@{node_ip}", remote_cmd
    ]


def handle_down_event(monitor_name, raw_details=""):
    key, spec = match_service(monitor_name)
    now = time.time()
    if key not in INCIDENT_STATE:
        INCIDENT_STATE[key] = {"down_since": now, "attempts": [], "cooldown_alerted": False}
    incident = INCIDENT_STATE[key]
    incident["attempts"] = [t for t in incident["attempts"] if now - t < COOLDOWN_WINDOW_SECONDS]

    if not spec or spec[0] == "alert_only":
        if not incident["cooldown_alerted"]:
            note = spec[1] if spec else "Servicio sin receta de auto-reparacion configurada."
            msg = (
                f"⚠️ *Alerta Homelab: Servicio Caido*\n\n"
                f"🔴 *Servicio:* `{monitor_name}`\n"
                f"ℹ️ *Nota:* {note}\n"
                f"📅 *Hora:* `{datetime.now().strftime('%H:%M:%S - %d/%m/%Y')}`"
            )
            send_telegram(msg)
            incident["cooldown_alerted"] = True
        return {"status": "alert_only", "service": monitor_name}

    if len(incident["attempts"]) >= MAX_RESTARTS_PER_WINDOW:
        if not incident["cooldown_alerted"]:
            msg = (
                f"🚨 *Alerta Homelab: Cooldown Alcanzado*\n\n"
                f"🔴 *Servicio:* `{monitor_name}`\n"
                f"⏳ *Auto-reparacion bloqueada:* Superados {MAX_RESTARTS_PER_WINDOW} intentos en {COOLDOWN_WINDOW_SECONDS//60} min.\n"
                f"📅 *Hora:* `{datetime.now().strftime('%H:%M:%S - %d/%m/%Y')}`"
            )
            send_telegram(msg)
            incident["cooldown_alerted"] = True
        return {"status": "rate_limited", "service": key}

    action_type = spec[0]
    incident["attempts"].append(now)
    print(f"[{datetime.now()}] Remediating {key} via {action_type}...")

    if action_type == "docker_vm103":
        container_name = spec[1]
        cmd = ssh_cmd(URANO_IP, f"qm guest exec 103 -- docker restart {container_name}")
    elif action_type == "lxc":
        ct_vmid, node_ip = spec[1], spec[2]
        cmd = ssh_cmd(node_ip, f"pct restart {ct_vmid}")
    elif action_type == "vm":
        vmid, node_ip = spec[1], spec[2]
        cmd = ssh_cmd(node_ip, f"qm start {vmid} || qm reboot {vmid}")
    else:
        return {"status": "unsupported", "service": key}

    try:
        subprocess.run(cmd, capture_output=True, text=True, timeout=35)
        time.sleep(8)
        if action_type == "docker_vm103":
            recovered = check_http_url(spec[2], timeout=4)
        else:
            recovered = check_tcp_port(spec[3], spec[4], timeout=3)

        if recovered:
            msg = (
                f"🤖 *Auto-reparacion Exitosa*\n\n"
                f"🟢 *Servicio:* `{monitor_name}`\n"
                f"🔄 *Accion:* Reinicio {action_type.upper()} ejecutado.\n"
                f"✅ *Resultado:* Servicio restablecido.\n"
                f"📅 *Hora:* `{datetime.now().strftime('%H:%M:%S - %d/%m/%Y')}`"
            )
            send_telegram(msg)
            INCIDENT_STATE.pop(key, None)
            return {"status": "recovered", "service": key}
        else:
            if len(incident["attempts"]) >= MAX_RESTARTS_PER_WINDOW:
                msg = (
                    f"⚠️ *Auto-reparacion Fallida*\n\n"
                    f"🔴 *Servicio:* `{monitor_name}`\n"
                    f"❌ Sin respuesta tras {MAX_RESTARTS_PER_WINDOW} intentos.\n" + (f"📋 *Logs recientes (VictoriaLogs):*\n`{fetch_recent_vlogs(key)}`" if fetch_recent_vlogs(key) else "🛠️ Intervencion manual requerida.")
                )
                send_telegram(msg)
                incident["cooldown_alerted"] = True
            return {"status": "restarted_unverified", "service": key}
    except Exception as e:
        send_telegram(f"❌ *Error en Auto-reparacion*\nServicio: `{monitor_name}`\nError: `{e}`")
        return {"status": "error", "error": str(e)}


def handle_up_event(monitor_name):
    key, _ = match_service(monitor_name)
    if key in INCIDENT_STATE:
        incident = INCIDENT_STATE[key]
        if incident.get("cooldown_alerted"):
            send_telegram(f"🟢 *Servicio Restablecido*\n`{monitor_name}` vuelve a estar *ONLINE*.")
        INCIDENT_STATE.pop(key, None)
        return {"status": "resolved", "service": key}
    return {"status": "already_up"}


class RemediatorHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"status": "ok", "services": len(SERVICE_CATALOG)}).encode())
            return
        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        client_ip = self.client_address[0]
        if ALLOWED_IPS and client_ip not in ALLOWED_IPS:
            print(f"[WARN] Blocked webhook from unauthorized IP: {client_ip}", flush=True)
            self.send_response(403)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"error":"forbidden"}')
            return
        length = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(length).decode("utf-8", "ignore")
        try:
            payload = json.loads(raw) if raw else {}
        except Exception:
            payload = {}
        hb = payload.get("heartbeat") or {}
        mon = payload.get("monitor") or {}
        name = mon.get("name") or payload.get("service") or "unknown"
        status = hb.get("status")
        if status == 0:
            res = handle_down_event(name, hb.get("msg", ""))
        elif status == 1:
            res = handle_up_event(name)
        else:
            res = {"status": "ignored"}
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(res).encode())


if __name__ == "__main__":
    server = http.server.ThreadingHTTPServer(("0.0.0.0", PORT), RemediatorHandler)
    print(f"[INFO] Homelab Remediator v3.0 listening on port {PORT} ({len(SERVICE_CATALOG)} services)")
    server.serve_forever()
