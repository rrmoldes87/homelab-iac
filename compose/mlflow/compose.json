{
  "services": {
    "web": {
      "image": "ghcr.io/mlflow/mlflow@sha256:4590656b2856508ba1eb6885cb9f4d2e747b164ed0d999fa542e4573843c4c8a",
      "pull_policy": "never",
      "restart": "no",
      "mem_limit": "1024m",
      "cpus": 0.5,
      "stop_grace_period": "60s",
      "ports": [
        "192.168.1.92:18099:5000"
      ],
      "volumes": [
        "/var/lib/homelab-mlflow/data:/mlflow"
      ],
      "entrypoint": [
        "mlflow"
      ],
      "command": [
        "server",
        "--host",
        "0.0.0.0",
        "--port",
        "5000",
        "--backend-store-uri",
        "sqlite:////mlflow/mlflow.db",
        "--default-artifact-root",
        "/mlflow/artifacts",
        "--allowed-hosts",
        "mlflow.<TU_DOMINIO>,localhost:*"
      ]
    }
  }
}
