{
  "services": {
    "web": {
      "image": "lscr.io/linuxserver/radarr@sha256:ade5937813c6ae415b29db729386e53fea3ecf067a019849bafbe2d2a6ec02ba",
      "pull_policy": "never",
      "restart": "no",
      "environment": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "Europe/Madrid"
      },
      "ports": [
        "192.168.1.92:18095:7878"
      ],
      "volumes": [
        "/var/lib/homelab-radarr/config:/config",
        {
          "type": "volume",
          "source": "media",
          "target": "/data",
          "volume": {
            "nocopy": true
          }
        }
      ],
      "mem_limit": "512m",
      "cpus": 0.5,
      "stop_grace_period": "60s"
    }
  },
  "volumes": {
    "media": {
      "external": true,
      "name": "homelab-audiobookshelf-media"
    }
  }
}
