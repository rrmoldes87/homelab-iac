{
  "services": {
    "web": {
      "image": "lscr.io/linuxserver/sonarr@sha256:48e36b608b461273b9dae857725cd0561a127f2c694b687318f6d0c5ce63e5c9",
      "pull_policy": "never",
      "restart": "no",
      "environment": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "Europe/Madrid"
      },
      "ports": [
        "192.168.1.92:18094:8989"
      ],
      "volumes": [
        "/var/lib/homelab-sonarr/config:/config",
        {
          "type": "volume",
          "source": "media",
          "target": "/data",
          "volume": {
            "nocopy": true
          }
        }
      ],
      "mem_limit": "512m",
      "cpus": 0.5,
      "stop_grace_period": "60s"
    }
  },
  "volumes": {
    "media": {
      "external": true,
      "name": "homelab-audiobookshelf-media"
    }
  }
}
