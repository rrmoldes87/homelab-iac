{
  "services": {
    "web": {
      "image": "lscr.io/linuxserver/bazarr@sha256:e0c5d45965242830c5eeddaafe9ae2b5e8ca3f6c01ecda9ee9364f550921dc50",
      "pull_policy": "never",
      "restart": "no",
      "environment": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "Europe/Madrid"
      },
      "ports": [
        "192.168.1.92:18097:6767"
      ],
      "volumes": [
        "/var/lib/homelab-bazarr/config:/config",
        {
          "type": "volume",
          "source": "media",
          "target": "/data",
          "volume": {
            "nocopy": true
          }
        }
      ],
      "mem_limit": "512m",
      "cpus": 0.5,
      "stop_grace_period": "60s"
    }
  },
  "volumes": {
    "media": {
      "external": true,
      "name": "homelab-audiobookshelf-media"
    }
  }
}
