{
  "services": {
    "web": {
      "image": "lscr.io/linuxserver/qbittorrent@sha256:3d4c4545d51a690a0df15a2ff99038823a88a9822df8e794526447b9afbd7384",
      "pull_policy": "never",
      "restart": "no",
      "environment": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "Europe/Madrid",
        "WEBUI_PORT": "8701"
      },
      "ports": [
        "192.168.1.92:18098:8701",
        "192.168.1.92:6881:6881/tcp",
        "192.168.1.92:6881:6881/udp"
      ],
      "volumes": [
        "/var/lib/homelab-qbittorrent/config:/config",
        {
          "type": "volume",
          "source": "media",
          "target": "/data",
          "volume": {
            "nocopy": true
          }
        }
      ],
      "mem_limit": "1024m",
      "cpus": 1.0,
      "stop_grace_period": "60s"
    }
  },
  "volumes": {
    "media": {
      "external": true,
      "name": "homelab-audiobookshelf-media"
    }
  }
}
